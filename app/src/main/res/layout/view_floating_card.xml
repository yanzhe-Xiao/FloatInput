<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRoot"
    android:layout_width="310dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glassmorphic_card"
    android:elevation="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Header: Drag Handle & Actions -->
        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <!-- Drag Handle Bar Indicator -->
            <ImageView
                android:id="@+id/ivDragHandle"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/desc_drag_handle"
                android:src="@drawable/ic_drag_handle"
                app:tint="#80FFFFFF" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/app_name_full"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Collapse to Sidebar Button -->
            <ImageView
                android:id="@+id/btnCollapse"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_btn_icon_ripple"
                android:contentDescription="@string/action_collapse"
                android:padding="5dp"
                android:src="@drawable/ic_collapse"
                app:tint="#B3FFFFFF" />

            <!-- Close Floating Window Button -->
            <ImageView
                android:id="@+id/btnClose"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_btn_icon_ripple"
                android:contentDescription="@string/action_close"
                android:padding="5dp"
                android:src="@drawable/ic_close"
                app:tint="#B3FFFFFF" />
        </LinearLayout>

        <!-- Input Box: EditText without secure keyboard restrictions -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_box"
            android:padding="10dp">

            <EditText
                android:id="@+id/etInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="top|start"
                android:hint="@string/hint_input"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="8"
                android:minLines="3"
                android:scrollbars="vertical"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#66FFFFFF"
                android:textSize="15sp"
                tools:ignore="Autofill" />
        </FrameLayout>

        <!-- Bottom Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Character counter -->
            <TextView
                android:id="@+id/tvCharCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0 字"
                android:textColor="#80FFFFFF"
                android:textSize="12sp" />

            <!-- Clear Button -->
            <LinearLayout
                android:id="@+id/btnClear"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_clear"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_clear"
                    app:tint="#EF4444" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/action_clear"
                    android:textColor="#EF4444"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Copy Button -->
            <LinearLayout
                android:id="@+id/btnCopy"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_copy"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:id="@+id/ivCopyIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_copy"
                    app:tint="#10B981" />

                <TextView
                    android:id="@+id/tvCopyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/action_copy"
                    android:textColor="#10B981"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
