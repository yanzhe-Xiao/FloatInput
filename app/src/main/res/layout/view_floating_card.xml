<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRoot"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glassmorphic_card"
    android:elevation="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Drag Handle & Title & Actions -->
        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="10dp">

            <!-- Active Neon Indicator Dot -->
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="#38BDF8" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="微浮输入"
                android:textColor="#F1F5F9"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Version tag badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_char"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="v1.2.0"
                android:textColor="#94A3B8"
                android:textSize="10sp" />

            <!-- Spacer / Drag indicator -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivDragHandle"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/desc_drag_handle"
                    android:src="@drawable/ic_drag_handle"
                    app:tint="#64748B" />
            </LinearLayout>

            <!-- Collapse to Sidebar Button -->
            <ImageView
                android:id="@+id/btnCollapse"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_btn_icon_ripple"
                android:contentDescription="@string/action_collapse"
                android:padding="6dp"
                android:src="@drawable/ic_collapse"
                app:tint="#CBD5E1" />

            <!-- Close Floating Window Button -->
            <ImageView
                android:id="@+id/btnClose"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_btn_icon_ripple"
                android:contentDescription="@string/action_close"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                app:tint="#CBD5E1" />
        </LinearLayout>

        <!-- Input Box: EditText without secure keyboard restrictions -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_box"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <EditText
                android:id="@+id/etInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="top|start"
                android:hint="@string/hint_input"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingMultiplier="1.2"
                android:maxLines="7"
                android:minLines="3"
                android:scrollbars="vertical"
                android:textColor="#F8FAFC"
                android:textColorHint="#475569"
                android:textSize="15sp"
                tools:ignore="Autofill" />
        </FrameLayout>

        <!-- Bottom Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Character counter Badge -->
            <TextView
                android:id="@+id/tvCharCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_char"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="0 字符"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Clear Button -->
            <LinearLayout
                android:id="@+id/btnClear"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_clear"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_clear"
                    app:tint="#F87171" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="@string/action_clear"
                    android:textColor="#F87171"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Copy Button -->
            <LinearLayout
                android:id="@+id/btnCopy"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_copy"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:id="@+id/ivCopyIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_copy"
                    app:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/tvCopyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/action_copy"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
